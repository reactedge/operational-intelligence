# Express server
PORT=8081
FRONTEND_URL=http://localhost:3001
CACHE_WARMER_ALLOWED_HOSTS=mageosuk.reactedge.net,mageos-docker.magsite.co.uk

# Continuous sitemap worker
CACHE_WARMER_WORKER_ENABLED=false
CACHE_WARMER_SITEMAP_URL=https://mageos-docker.magsite.co.uk/media/sitemap/uk.xml
CACHE_WARMER_MINIMUM_PRIORITY=0.5
CACHE_WARMER_BATCH_SIZE=5
CACHE_WARMER_CYCLE_INTERVAL_MS=300000
CACHE_WARMER_DEFER_RETRY_MS=30000

# Platform gate checked before each worker batch
PLATFORM_SIGNALS_STATUS_URL=http://127.0.0.1:8000/status
PLATFORM_SIGNALS_TIMEOUT_MS=5000
PLATFORM_MAX_CPU_PERCENT=85
PLATFORM_MAX_MEMORY_PERCENT=85
PLATFORM_MAX_DISK_PERCENT=90

# Read-only folder for versioned prompts and operational artefacts
CDN_FOLDER=csv_export

# OpenTelemetry
OTEL_HOST=http://localhost:4318
OTEL_CACHE_WARMER_SERVICE=reactedge-cache-warmer

# OpenAI (leave blank until the AI decision step is enabled)
OPENAI_MODEL=gpt-4o-mini
OPENAI_PERFORMANCE=0.2
OPENAI_API_KEY=
