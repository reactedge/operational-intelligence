# Express server
PORT=8080
FRONTEND_URL=http://localhost:3001

# Read-only folder for versioned prompts and operational artefacts
CDN_FOLDER=csv_export

# OpenTelemetry
OTEL_HOST=http://localhost:4318
OTEL_CACHE_WARMER_SERVICE=reactedge-cache-warmer

# OpenAI (leave blank until the AI decision step is enabled)
OPENAI_MODEL=gpt-4o-mini
OPENAI_PERFORMANCE=0.2
OPENAI_API_KEY=
